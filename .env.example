# =====================================================================
# AI-Powered Multi-Platform Prospect Discovery API - Configuration
# =====================================================================

# Server Configuration
PORT=4000
HOST=0.0.0.0
DEBUG=False
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Search Provider Configuration: 'serper', 'brave', or 'auto' (falls back to ddg if keys empty)
SEARCH_PROVIDER=auto
SERPER_API_KEY=your_serper_api_key_here
BRAVE_API_KEY=your_brave_api_key_here

# LLM Provider Configuration: 'gemini', 'openai', 'anthropic', or 'auto' (falls back to deterministic NLP)
LLM_PROVIDER=auto
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Pipeline Parameters
MAX_RESULTS_PER_PLATFORM=5
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_CONCURRENCY=4
RELEVANCE_THRESHOLD=35
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000
