# =====================================================================
# AI-Powered Multi-Platform Prospect Discovery API - Configuration
# =====================================================================

# Server & Security Configuration
PORT=4000
HOST=0.0.0.0
DEBUG=False
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
TRUSTED_PROXIES=

# Search Provider Configuration: 'serper', 'brave', 'ddg', or 'auto' (falls back to ddg)
SEARCH_PROVIDER=auto
SERPER_API_KEY=your_serper_api_key_here
BRAVE_API_KEY=your_brave_api_key_here

# LLM Provider Configuration: 'openai', 'gemini', 'anthropic', 'fallback', or 'auto'
LLM_PROVIDER=auto
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-5-5

# Pipeline Parameters
MAX_RESULTS_PER_PLATFORM=5
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_CONCURRENCY=4
RELEVANCE_THRESHOLD=35
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000
